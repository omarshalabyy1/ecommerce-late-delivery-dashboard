	measure 'Revenue vs LY % CF' = VAR v = [Revenue vs LY %] RETURN IF ( ISBLANK ( v ), "#8A94A0", IF ( v > 0, "#2E9E6B", IF ( v < 0, "#C2410C", "#8A94A0" ) ) )
		isHidden
		displayFolder: Colours
		lineageTag: 528fe16e-2e98-56e1-a33c-72b5693f70b3

	/// Hidden: hex colour of the comparison line Review Gap Late vs On Time, green for good, red for bad, grey for none.
	measure 'Review Gap Late vs On Time CF' = VAR v = [Review Gap Late vs On Time] RETURN IF ( ISBLANK ( v ), "#8A94A0", IF ( v > 0, "#2E9E6B", IF ( v < 0, "#C2410C", "#8A94A0" ) ) )
		isHidden
		displayFolder: Colours
		lineageTag: 45d25b39-f47d-5be2-bc9d-3542a8220aeb

	column Value
		dataType: int64
		isHidden
