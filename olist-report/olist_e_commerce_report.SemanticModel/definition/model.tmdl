model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Customer
ref table Geography
ref table Product
ref table Seller
ref table 'Order Status'
ref table 'Price Band'
ref table 'Payment Type'
ref table Sales
ref table Payments
ref table _Measures

ref cultureInfo en-US

